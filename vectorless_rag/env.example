# Copy into project root .env (never commit .env)

# --- Mode: local (free, on-disk) or cloud (OCR, managed storage) ---
PAGEINDEX_MODE=cloud

# PageIndex Cloud key — https://developer.pageindex.ai/
PAGEINDEX_API_KEY=your-pageindex-api-key

# Google Gemini (LiteLLM) — must use gemini/ prefix in model names
GOOGLE_API_KEY=your-google-api-key

# Models (official README uses separate index + chat models)
# Local:  index model builds tree summaries; chat model searches tree
# Cloud:  index is always "cloud"; only chat model is set below
PAGEINDEX_INDEX_MODEL=gemini/gemini-2.0-flash
PAGEINDEX_CHAT_MODEL=gemini/gemini-2.0-flash

# Local mode only — where tree JSON is stored on disk
PAGEINDEX_STORAGE_PATH=data/pageindex

# Default PDF folder
PDF_DOCUMENTS_DIR=data/pdf_files
